# Server Environment
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://arogyamitra-chi.vercel.app

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Authentication & Security
JWT_SECRET_KEY=arogyamitra-jwt-secret-2024
SECRET_KEY=arogyamitra-super-secret-key-2024
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Coach (Groq)
GROQ_API_KEY=your_groq_api_key_here

# Google Calendar OAuth2
GOOGLE_CALENDAR_CLIENT_ID=your_google_calendar_client_id
GOOGLE_CALENDAR_CLIENT_SECRET=your_google_calendar_client_secret
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/api/calendar/callback

# YouTube Data API
YOUTUBE_API_KEY=your_youtube_api_key_here

# Spoonacular Nutrition API
SPOONACULAR_API_KEY=your_spoonacular_api_key_here